# ── Browser (public by design; anything with VITE_ ships to the browser) ───
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<the Practice app's anon key>

# ── Server only (Vercel → Settings → Environment Variables). Never VITE_. ──
SUPABASE_SERVICE_ROLE_KEY=<the Practice app's service role key>

# Stripe: the same account the Practice app bills through. A SECOND webhook
# endpoint, made by hand at <this app's URL>/api/stripe (see README).
STRIPE_SECRET_KEY=sk_live_…
STRIPE_WEBHOOK_SECRET=whsec_…

# Email, the Welcome Journey. Resend, with the domain that sends the Practice's mail.
RESEND_API_KEY=re_…
MAIL_FROM=The Practice <practice@innerboard.com>
# Where members' replies go ("Reply and tell me"): an inbox Leah reads. Optional; else replies go to MAIL_FROM.
MAIL_REPLY_TO=

# Text, optional, once the carrier registration is through (README).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Discord: a webhook made on the #wins channel (channel settings → Integrations → Webhooks).
DISCORD_WINS_WEBHOOK_URL=

# The hourly job's own secret (Vercel sends it as a bearer token to /api/cron).
CRON_SECRET=<any long random string>

# Where members are: the Practice app's address, for every link in an email.
PRACTICE_URL=https://www.practiceinnerboard.com
# This app's own address, for the admin view's links.
APP_URL=
